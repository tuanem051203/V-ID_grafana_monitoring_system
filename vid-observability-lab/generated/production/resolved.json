{
  "alertmanager_critical_recipients": "vid-sre@example.com,vid-oncall@example.com",
  "alertmanager_critical_repeat_interval": "1h",
  "alertmanager_group_by": "alertname, environment, cluster, service",
  "alertmanager_group_interval": "5m",
  "alertmanager_group_wait": "30s",
  "alertmanager_repeat_interval": "4h",
  "alertmanager_resolve_timeout": "5m",
  "alertmanager_smtp_from": "vid-alerts@example.com",
  "alertmanager_smtp_password_file": "/run/secrets/smtp_password",
  "alertmanager_smtp_require_tls": "true",
  "alertmanager_smtp_smarthost": "smtp.example.com:587",
  "alertmanager_smtp_username": "vid-alerts@example.com",
  "alertmanager_warning_recipients": "vid-sre@example.com",
  "cluster": "vid-production",
  "environment": "production",
  "grafana_admin_user": "admin",
  "grafana_datasource_interval": "5s",
  "grafana_datasource_url": "http://prometheus:9090",
  "images_alertmanager": "prom/alertmanager:v0.28.1",
  "images_grafana": "grafana/grafana:12.1.0",
  "images_otel_collector": "otel/opentelemetry-collector-contrib:0.131.1",
  "images_prometheus": "prom/prometheus:v3.5.0",
  "images_tempo": "grafana/tempo:2.8.2",
  "ports_alertmanager": "9093",
  "ports_grafana": "3000",
  "ports_metrics_simulator": "8000",
  "ports_prometheus": "9090",
  "ports_tempo": "3200",
  "project_name": "vid-observability-production",
  "prometheus_evaluation_interval": "5s",
  "prometheus_scrape_interval": "5s",
  "public_urls_alertmanager": "https://alertmanager.example.com",
  "public_urls_grafana": "https://grafana.example.com",
  "public_urls_metrics_simulator": "https://metrics.example.com",
  "public_urls_prometheus": "https://prometheus.example.com",
  "public_urls_runbooks": "https://docs.example.com/runbooks",
  "targets_alertmanager": "alertmanager:9093",
  "targets_metrics_simulator": "metrics-simulator:8000",
  "targets_prometheus": "prometheus:9090",
  "tracing_otp_trace_ratio": "0.1",
  "tracing_propagators": "tracecontext,baggage",
  "tracing_sampler": "parentbased_traceidratio",
  "tracing_sampler_arg": "0.1",
  "tracing_service_version": "2.0.0"
}
