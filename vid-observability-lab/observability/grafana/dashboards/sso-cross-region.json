      "targets": [{"expr": "sum(vid:cross_region_requests:rate5m{environment=~\"$environment\",cluster=~\"$cluster\",source_region=~\"$source_region\",destination_region=~\"$destination_region\",service=~\"$service\"})", "legendFormat": "request/s", "refId": "A"}],
      "title": "Cross-region request rate", "type": "stat"
