{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {"id": 1, "title": "OTP journeys / second", "description": "International OTP journey throughput over five minutes.", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "sum(vid:otp_journey_requests:rate5m{environment=~\"$environment\",cluster=~\"$cluster\",destination_country=~\"$destination_country\",channel=~\"$channel\",provider=~\"$provider\"})", "legendFormat": "request/s", "refId": "A"}]},
    {"id": 2, "title": "Journey success", "description": "Successful terminal journeys divided by all journeys.", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 0.95}]}}}, "targets": [{"expr": "min(vid:otp_journey_success:ratio5m{environment=~\"$environment\",cluster=~\"$cluster\",destination_country=~\"$destination_country\",channel=~\"$channel\",provider=~\"$provider\"})", "legendFormat": "success", "refId": "A"}]},
    {"id": 3, "title": "Journey p95", "description": "End-to-end p95 including the provider delivery report boundary.", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"expr": "max(vid:otp_journey_latency:p95_5m{environment=~\"$environment\",cluster=~\"$cluster\",destination_country=~\"$destination_country\",channel=~\"$channel\",provider=~\"$provider\"})", "legendFormat": "p95", "refId": "A"}]},
    {"id": 4, "title": "Delivery p95", "description": "Provider submission-to-delivery-report p95; this is distinct from synchronous API latency.", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"expr": "max(vid:otp_delivery_latency:p95_5m{environment=~\"$environment\",cluster=~\"$cluster\",destination_country=~\"$destination_country\",channel=~\"$channel\",provider=~\"$provider\"})", "legendFormat": "delivery", "refId": "A"}]},
    {"id": 5, "title": "Stage latency p95 — bottleneck locator", "description": "Compare bounded stages; the stage whose p95 rises localizes the suspected bottleneck. Histogram exemplars link sampled journeys to Tempo.", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"expr": "vid:otp_stage_latency:p95_5m{environment=~\"$environment\",cluster=~\"$cluster\",destination_country=~\"$destination_country\",channel=~\"$channel\",provider=~\"$provider\",stage=~\"$stage\"}", "legendFormat": "{{stage}} / {{service}} / {{destination_country}}", "refId": "A"}]},
    {"id": 6, "title": "Stage error ratio", "description": "Failure ratio at each reached stage; stages after a terminal failure are intentionally absent.", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4}, "fieldConfig": {"defaults": {"unit": "percentunit"}}, "targets": [{"expr": "vid:otp_stage_error:ratio5m{environment=~\"$environment\",cluster=~\"$cluster\",destination_country=~\"$destination_country\",channel=~\"$channel\",provider=~\"$provider\",stage=~\"$stage\"}", "legendFormat": "{{stage}} / {{destination_country}}", "refId": "A"}]},
    {"id": 7, "title": "Terminal failures", "description": "Bounded terminal failure taxonomy by country, provider, stage and service.", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "targets": [{"expr": "sum by (destination_country, provider, stage, service, reason) (rate(otp_journey_failures_total{environment=~\"$environment\",cluster=~\"$cluster\",destination_country=~\"$destination_country\",channel=~\"$channel\",provider=~\"$provider\",stage=~\"$stage\"}[5m]))", "legendFormat": "{{destination_country}} / {{stage}} / {{reason}}", "refId": "A"}]},
    {"id": 8, "title": "Queue depth and wait p95", "description": "Queue backlog gauge and queue-wait histogram identify Notification Center pressure.", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "targets": [{"expr": "otp_queue_size{environment=~\"$environment\",cluster=~\"$cluster\"}", "legendFormat": "queue depth", "refId": "A"}, {"expr": "histogram_quantile(0.95, sum by (le, provider) (rate(otp_queue_wait_duration_seconds_bucket{environment=~\"$environment\",cluster=~\"$cluster\",provider=~\"$provider\"}[5m])))", "legendFormat": "wait p95 / {{provider}}", "refId": "B"}]},
    {"id": 9, "title": "Journey latency with trace exemplars", "description": "Raw histogram p95 retains sampled trace exemplars; click an exemplar marker to open its Tempo waterfall.", "type": "timeseries", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 21}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, destination_country, provider) (rate(otp_journey_duration_seconds_bucket{environment=~\"$environment\",cluster=~\"$cluster\",destination_country=~\"$destination_country\",channel=~\"$channel\",provider=~\"$provider\"}[5m])))", "legendFormat": "{{destination_country}} / {{provider}}", "refId": "A"}]}
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["vid", "identity", "otp", "tracing", "managed-by-git"],
  "templating": {"list": [
    {"name": "environment", "label": "Environment", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(otp_journey_requests_total, environment)", "refId": "env"}, "includeAll": true, "current": {"text": "All", "value": "$__all"}, "refresh": 1},
    {"name": "cluster", "label": "Cluster", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(otp_journey_requests_total{environment=~\"$environment\"}, cluster)", "refId": "cluster"}, "includeAll": true, "current": {"text": "All", "value": "$__all"}, "refresh": 1},
    {"name": "destination_country", "label": "Destination country", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(otp_journey_requests_total, destination_country)", "refId": "country"}, "includeAll": true, "current": {"text": "All", "value": "$__all"}, "refresh": 1},
    {"name": "channel", "label": "Channel", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(otp_journey_requests_total, channel)", "refId": "channel"}, "includeAll": true, "current": {"text": "All", "value": "$__all"}, "refresh": 1},
    {"name": "provider", "label": "Provider", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(otp_journey_requests_total, provider)", "refId": "provider"}, "includeAll": true, "current": {"text": "All", "value": "$__all"}, "refresh": 1},
    {"name": "stage", "label": "Stage", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(otp_stage_requests_total, stage)", "refId": "stage"}, "includeAll": true, "current": {"text": "All", "value": "$__all"}, "refresh": 1}
  ]},
