      ],
      "title": "Authentication Outcomes",
      "type": "timeseries",
      "description": "Số yêu cầu xác thực mỗi giây theo kết quả trong cửa sổ trượt 5 phút. Sử dụng lưu lượng thất bại để phát hiện suy giảm xác thực và đối chiếu với độ trễ."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
