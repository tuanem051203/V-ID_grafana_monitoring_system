        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(auth_request_duration_seconds_bucket{environment=~\"$environment\",cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(auth_request_duration_seconds_bucket{environment=~\"$environment\",cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(auth_request_duration_seconds_bucket{environment=~\"$environment\",cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Authentication Latency",
      "type": "timeseries",
      "description": "Các phân vị thời gian phản hồi xác thực được tính từ histogram trong cửa sổ 5 phút. p95 và p99 giúp phát hiện độ trễ phần đuôi mà giá trị trung vị có thể che khuất."
    },
