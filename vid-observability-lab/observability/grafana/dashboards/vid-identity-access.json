            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(rate(authorization_decisions_total{environment=~\"$environment\",cluster=~\"$cluster\",decision=\"allow\"}[5m])) / clamp_min(sum(rate(authorization_decisions_total{environment=~\"$environment\",cluster=~\"$cluster\"}[5m])), 1e-9)",
          "legendFormat": "Allowed",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Authorization Allow Rate",
      "type": "stat",
      "description": "Phần trăm quyết định phân quyền cho phép truy cập trong cửa sổ 5 phút. Cần diễn giải cùng lưu lượng và lý do từ chối; đây là đường cơ sở vận hành, chưa phải SLO được phê duyệt."
