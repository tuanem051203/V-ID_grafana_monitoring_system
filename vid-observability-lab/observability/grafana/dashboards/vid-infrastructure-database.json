  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 106,
      "panels": [],
      "title": "Infrastructure",
      "type": "row",
      "description": "Mức sử dụng tài nguyên node giả lập và trạng thái sẵn sàng của pod trên nền tảng V-ID."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "id": 13,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "infrastructure_cpu_usage_ratio{environment=~\"$environment\",cluster=~\"$cluster\"}",
          "legendFormat": "CPU {{node}}",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "infrastructure_memory_usage_ratio{environment=~\"$environment\",cluster=~\"$cluster\"}",
          "legendFormat": "Memory {{node}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Node Resource Usage",
      "type": "timeseries",
      "description": "Tỷ lệ sử dụng CPU và bộ nhớ hiện tại theo từng node giả lập. Giá trị duy trì gần 100% cho thấy tài nguyên bão hòa và cần được đối chiếu với độ trễ và lỗi."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "NOT READY"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "READY"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 14,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "pod_ready{environment=~\"$environment\",cluster=~\"$cluster\"}",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Pod Readiness",
      "type": "stat",
      "description": "Trạng thái sẵn sàng mới nhất của từng pod ứng dụng giả lập: READY bằng 1 và NOT READY bằng 0. Bất kỳ pod nào chưa sẵn sàng đều có thể làm giảm năng lực hoặc khả năng dự phòng của dịch vụ."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 107,
      "panels": [],
      "title": "Database",
      "type": "row",
      "description": "Các chỉ số độ trễ truy vấn, dung lượng kết nối và độ tin cậy của database."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 15,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(database_query_duration_seconds_bucket{environment=~\"$environment\",cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "{{operation}} p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Database Query Latency",
      "type": "timeseries",
      "description": "Thời gian truy vấn database p95 theo từng loại thao tác, được tính từ histogram trong cửa sổ 5 phút. So sánh select, insert và update để xác định luồng truy vấn chậm."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 10
      },
      "id": 16,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(database_connections{environment=~\"$environment\",cluster=~\"$cluster\",state=\"active\"}) / clamp_min(sum(database_max_connections{environment=~\"$environment\",cluster=~\"$cluster\"}), 1)",
          "legendFormat": "Used",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Connection Usage",
      "type": "stat",
      "description": "Phần trăm số kết nối database được cấu hình đang ở trạng thái hoạt động. Việc duy trì trên ngưỡng cảnh báo hoặc nghiêm trọng có thể gây xếp hàng và lỗi kết nối."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "id": 17,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(rate(database_queries_total{environment=~\"$environment\",cluster=~\"$cluster\",result=\"error\"}[5m])) / clamp_min(sum(rate(database_queries_total{environment=~\"$environment\",cluster=~\"$cluster\"}[5m])), 1e-9)",
          "legendFormat": "Errors",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Database Error Rate",
      "type": "stat",
      "description": "Phần trăm truy vấn database có result=error trong cửa sổ trượt 5 phút. Cần diễn giải tỷ lệ này cùng lưu lượng truy vấn và độ trễ database."
    }
  ],
