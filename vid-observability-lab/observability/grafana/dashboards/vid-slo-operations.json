{
  "annotations": {
    "list": []
  },
  "description": "Operational view for V-ID SLO, error budget, burn rate and telemetry health.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "V-ID KPI Overview",
      "type": "link",
      "url": "/d/vid-kpi-overview"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "1 means Prometheus can scrape the metrics target; 0 means telemetry is unavailable.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "up{job=\"vid-metrics-simulator\",environment=~\"$environment\",cluster=~\"$cluster\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Metrics Target Health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Prometheus rule evaluation failures during the selected period.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(prometheus_rule_evaluation_failures_total[$__range]))",
          "legendFormat": "Failures",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Rule Evaluation Failures",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Eligible traffic used by each KPI denominator. A zero value makes ratio interpretation unsafe.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "vid:eligible_requests:rate5m{environment=~\"$environment\",cluster=~\"$cluster\"}",
          "legendFormat": "{{kpi}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Eligible Traffic by KPI",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Estimated remaining 30-day error budget. KPI-04 is omitted because its SLO is not approved.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "vid:slo_authentication_success:error_budget_remaining30d{environment=~\"$environment\",cluster=~\"$cluster\"} * 100",
          "legendFormat": "Auth success",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "vid:slo_authentication_latency:error_budget_remaining30d{environment=~\"$environment\",cluster=~\"$cluster\"} * 100",
          "legendFormat": "Auth latency",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "vid:slo_otp_delivery:error_budget_remaining30d{environment=~\"$environment\",cluster=~\"$cluster\"} * 100",
          "legendFormat": "OTP delivery",
          "range": true,
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "vid:slo_token_issuance:error_budget_remaining30d{environment=~\"$environment\",cluster=~\"$cluster\"} * 100",
          "legendFormat": "Token issuance",
          "range": true,
          "refId": "D"
        },
        {
          "editorMode": "code",
          "expr": "vid:slo_platform_availability:error_budget_remaining30d{environment=~\"$environment\",cluster=~\"$cluster\"} * 100",
          "legendFormat": "Platform availability",
          "range": true,
          "refId": "E"
        }
      ],
      "title": "30-day Error Budget Remaining",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "5-minute error-budget consumption rate. Above 1x is unsustainable; above 14.4x participates in fast-burn paging.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "{__name__=~\"vid:slo_.*:burnrate5m\",environment=~\"$environment\",cluster=~\"$cluster\"}",
          "legendFormat": "{{__name__}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Fast Burn Rate (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Current firing and pending alerts for the selected environment and cluster.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "ALERTS{alertstate=~\"pending|firing\",environment=~\"$environment\",cluster=~\"$cluster\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Active Alerts",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "v-id",
    "slo",
    "operations"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "local",
          "value": "local"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"vid-metrics-simulator\"}, environment)",
        "includeAll": true,
        "label": "Environment",
        "multi": true,
        "name": "environment",
        "options": [],
        "query": {
          "query": "label_values(up{job=\"vid-metrics-simulator\"}, environment)",
          "refId": "env"
        },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "docker-compose",
          "value": "docker-compose"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"vid-metrics-simulator\",environment=~\"$environment\"}, cluster)",
        "includeAll": true,
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "options": [],
        "query": {
          "query": "label_values(up{job=\"vid-metrics-simulator\",environment=~\"$environment\"}, cluster)",
          "refId": "cluster"
        },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "V-ID — SLO & Operations",
  "uid": "vid-slo-operations",
  "version": 1
}
