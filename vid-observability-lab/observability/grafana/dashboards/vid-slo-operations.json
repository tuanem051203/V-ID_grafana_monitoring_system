      "url": "/d/vid-infrastructure-database"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Giá trị 1 nghĩa là Prometheus thu thập được metrics target; giá trị 0 nghĩa là telemetry không khả dụng. Hãy xử lý lỗi telemetry trước khi kết luận dịch vụ gặp sự cố.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "up{job=\"vid-metrics-simulator\",environment=~\"$environment\",cluster=~\"$cluster\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Metrics Target Health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Số lần Prometheus đánh giá rule thất bại trong khoảng thời gian đang chọn. Giá trị lớn hơn 0 cho thấy recording rule hoặc alert rule có thể không tạo ra kết quả tin cậy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(prometheus_rule_evaluation_failures_total[$__range]))",
          "legendFormat": "Failures",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Rule Evaluation Failures",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Lưu lượng đủ điều kiện được dùng làm mẫu số của từng KPI. Giá trị bằng 0 hoặc quá thấp khiến việc diễn giải tỷ lệ không an toàn.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "vid:eligible_requests:rate5m{environment=~\"$environment\",cluster=~\"$cluster\"}",
          "legendFormat": "{{kpi}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Eligible Traffic by KPI",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Phần error budget 30 ngày ước tính còn lại. KPI-04 không được hiển thị vì SLO của KPI này chưa được phê duyệt; giá trị âm cho thấy đã sử dụng vượt ngân sách.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "vid:slo_authentication_success:error_budget_remaining30d{environment=~\"$environment\",cluster=~\"$cluster\"} * 100",
          "legendFormat": "Auth success",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "vid:slo_authentication_latency:error_budget_remaining30d{environment=~\"$environment\",cluster=~\"$cluster\"} * 100",
          "legendFormat": "Auth latency",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "vid:slo_otp_delivery:error_budget_remaining30d{environment=~\"$environment\",cluster=~\"$cluster\"} * 100",
          "legendFormat": "OTP delivery",
          "range": true,
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "vid:slo_token_issuance:error_budget_remaining30d{environment=~\"$environment\",cluster=~\"$cluster\"} * 100",
          "legendFormat": "Token issuance",
          "range": true,
          "refId": "D"
        },
        {
          "editorMode": "code",
          "expr": "vid:slo_platform_availability:error_budget_remaining30d{environment=~\"$environment\",cluster=~\"$cluster\"} * 100",
          "legendFormat": "Platform availability",
          "range": true,
          "refId": "E"
        }
      ],
      "title": "30-day Error Budget Remaining",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Tốc độ tiêu thụ error budget trong cửa sổ 5 phút. Trên 1 lần là không bền vững; trên 14,4 lần tham gia điều kiện cảnh báo fast-burn.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "{__name__=~\"vid:slo_.*:burnrate5m\",environment=~\"$environment\",cluster=~\"$cluster\"}",
          "legendFormat": "{{__name__}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Fast Burn Rate (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Các cảnh báo đang firing hoặc pending trong môi trường và cụm đang chọn. Sử dụng nhãn severity, service và liên kết runbook để ưu tiên điều tra.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "ALERTS{alertstate=~\"pending|firing\",environment=~\"$environment\",cluster=~\"$cluster\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Active Alerts",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "operations",
    "slo",
    "v-id",
    "vid"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
