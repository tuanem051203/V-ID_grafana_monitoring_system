{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "Sự kiện mô phỏng",
        "target": {
          "editorMode": "code",
          "expr": "simulation_event_active{environment=~\"$environment\",cluster=~\"$cluster\"} == 1",
          "legendFormat": "{{event}}",
          "range": true,
          "refId": "simulation-events"
        },
        "type": "dashboard"
      }
    ]
  },
  "description": "Góc nhìn vận hành về SLO, error budget, burn rate và sức khỏe telemetry của V-ID.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Overview",
