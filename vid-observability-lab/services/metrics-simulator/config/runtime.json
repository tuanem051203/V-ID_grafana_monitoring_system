{
  "$schema": "./runtime.schema.json",
  "version": 1,
  "environments": {
    "local": {
      "load_profile": "development",
      "generation_interval_seconds": 5,
      "simulation_day_seconds": 86400,
      "random_seed": 20250730
    },
    "uat": {
      "load_profile": "uat",
      "generation_interval_seconds": 5,
      "simulation_day_seconds": 86400,
      "random_seed": 20250730
    },
    "production": {
      "load_profile": "production",
      "generation_interval_seconds": 5,
      "simulation_day_seconds": 86400,
      "random_seed": 20250730
    },
    "peak": {
      "load_profile": "peak",
      "generation_interval_seconds": 5,
      "simulation_day_seconds": 3600,
      "random_seed": 20250730
    }
  },
  "noise_ratio": 0.05,
  "load_profiles": {
    "development": {"peak_tps": 20},
    "uat": {"peak_tps": 100},
    "production": {"peak_tps": 500},
    "peak": {"peak_tps": 2000}
  },
  "cross_region": {
    "enabled": true,
    "source_region": "vn",
    "traffic_ratio": 0.10,
    "latency_sigma": 0.35,
    "destinations": [
      {"destination_region": "us", "traffic_weight": 0.20, "hops": [
        {"name": "vn_to_dc", "latency_p50_seconds": 0.04, "failure_rate": 0.001},
        {"name": "dc_to_destination", "latency_p50_seconds": 0.22, "failure_rate": 0.003},
        {"name": "destination_to_service", "latency_p50_seconds": 0.06, "failure_rate": 0.001}
      ]},
      {"destination_region": "dk", "traffic_weight": 0.06, "hops": [
        {"name": "vn_to_dc", "latency_p50_seconds": 0.04, "failure_rate": 0.001},
        {"name": "dc_to_destination", "latency_p50_seconds": 0.20, "failure_rate": 0.003},
        {"name": "destination_to_service", "latency_p50_seconds": 0.05, "failure_rate": 0.001}
      ]},
      {"destination_region": "id", "traffic_weight": 0.18, "hops": [
        {"name": "vn_to_dc", "latency_p50_seconds": 0.04, "failure_rate": 0.001},
        {"name": "dc_to_destination", "latency_p50_seconds": 0.08, "failure_rate": 0.002},
        {"name": "destination_to_service", "latency_p50_seconds": 0.04, "failure_rate": 0.001}
      ]},
      {"destination_region": "ph", "traffic_weight": 0.15, "hops": [
        {"name": "vn_to_dc", "latency_p50_seconds": 0.04, "failure_rate": 0.001},
        {"name": "dc_to_destination", "latency_p50_seconds": 0.10, "failure_rate": 0.002},
        {"name": "destination_to_service", "latency_p50_seconds": 0.04, "failure_rate": 0.001}
      ]},
      {"destination_region": "la", "traffic_weight": 0.10, "hops": [
        {"name": "vn_to_dc", "latency_p50_seconds": 0.04, "failure_rate": 0.001},
        {"name": "dc_to_destination", "latency_p50_seconds": 0.04, "failure_rate": 0.002},
        {"name": "destination_to_service", "latency_p50_seconds": 0.03, "failure_rate": 0.001}
      ]},
      {"destination_region": "in", "traffic_weight": 0.15, "hops": [
        {"name": "vn_to_dc", "latency_p50_seconds": 0.04, "failure_rate": 0.001},
        {"name": "dc_to_destination", "latency_p50_seconds": 0.12, "failure_rate": 0.002},
        {"name": "destination_to_service", "latency_p50_seconds": 0.04, "failure_rate": 0.001}
      ]},
      {"destination_region": "kz", "traffic_weight": 0.05, "hops": [
        {"name": "vn_to_dc", "latency_p50_seconds": 0.04, "failure_rate": 0.001},
        {"name": "dc_to_destination", "latency_p50_seconds": 0.16, "failure_rate": 0.003},
        {"name": "destination_to_service", "latency_p50_seconds": 0.05, "failure_rate": 0.001}
      ]},
      {"destination_region": "ru", "traffic_weight": 0.06, "hops": [
        {"name": "vn_to_dc", "latency_p50_seconds": 0.04, "failure_rate": 0.001},
        {"name": "dc_to_destination", "latency_p50_seconds": 0.18, "failure_rate": 0.003},
